{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Kanban DSH Test",
  "mainBinaryName": "claude-kanban-dsh-test",
  "identifier": "io.github.hughht5.claude-kanban-dsh.test",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Kanban DSH (test)",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--remote-debugging-port=9334 --remote-allow-origins=http://127.0.0.1:9334 --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.test.nsh"
      }
    },
    "icon": [
      "icons-test/32x32.png",
      "icons-test/128x128.png",
      "icons-test/128x128@2x.png",
      "icons-test/icon.ico"
    ]
  }
}
